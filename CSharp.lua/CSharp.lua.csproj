<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!--<TargetFramework>net6.0</TargetFramework>-->
    <LangVersion>latest</LangVersion>
    <RootNamespace>CSharpLua</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Owners>mdlsvensson</Owners>
    <Copyright>Copyright © YANG Huan 2017</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <RepositoryUrl>https://github.com/mdlsvensson/CSharp.lua</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>YANG Huan, Drake53, mdlsvensson</Authors>

    <Description>Moonwell's fork of the C# to Lua compiler, from Drake53's edits to make it compatible with warcraft III lua maps.</Description>
    <PackageProjectUrl>https://github.com/mdlsvensson/CSharp.lua/tree/moonwell-package/CSharp.lua</PackageProjectUrl>
    <PackageTags>csharp lua compiler transpiler warcraft3 warcraft-iii</PackageTags>
    <PackageReleaseNotes></PackageReleaseNotes>

    <PackageId>Moonwell.CSharpLua</PackageId>
    <Version>2.0.4-moonwell.9</Version>
    <FileVersion>2.0.4.9</FileVersion>
    <AssemblyVersion>2.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cake.Common" Version="0.35.0" />
    <PackageReference Include="Cake.Incubator" Version="5.1.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="8.0.0.7345" />
    <!--<PackageReference Include="Microsoft.Build" Version="16.11.0" />-->
    <!--<PackageReference Include="Microsoft.Build.Utilities.Core" Version="16.11.0" />-->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="NuGet.Packaging" Version="6.14.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MetaResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>MetaResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="MetaResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>MetaResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The licence, and the notice of the files this fork changed (Apache-2.0, section 4), go in the package. -->
  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
